# ========================================================
# Sanjeevani Hospital Frontend Environment Configuration
# ========================================================

# Base API URL for backend communication
# For Local Development (Vite Proxy handles /api):
VITE_API_BASE_URL=/api

# For Production VPS Deployment:
# If frontend & backend are on same domain behind Nginx proxy:
# VITE_API_BASE_URL=/api
# If backend is on a subdomain or separate server:
# VITE_API_BASE_URL=https://api.yourdomain.com/api
